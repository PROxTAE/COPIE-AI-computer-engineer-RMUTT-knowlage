#!/usr/bin/env bash
# Blocks direct pushes to main/develop and enforces <module>/<feature> branch names.
BRANCH_RE='^(core|mascot|user|agent|rag|tools|renderer|suggest|intent-ml|export|qa|contract|hotfix|docs|release)/[a-z0-9][a-z0-9.-]*$'
ZERO=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_sha" == "$ZERO" ]] && continue   # branch deletion
  name="${remote_ref#refs/heads/}"
  [[ "$remote_ref" == refs/tags/* ]] && continue
  if [[ "$name" == "main" || "$name" == "develop" ]]; then
    echo "✖ ห้าม push ตรงไป $name — push branch ของตัวเองแล้วเปิด Pull Request เข้า develop"
    exit 1
  fi
  if ! [[ "$name" =~ $BRANCH_RE ]]; then
    echo "✖ ชื่อ branch '$name' ไม่ตรงกติกา <module>/<feature>"
    echo "  module ที่ใช้ได้: core mascot user agent rag tools renderer suggest intent-ml export qa contract hotfix docs release"
    echo "  เปลี่ยนชื่อ: git branch -m <module>/<feature>"
    exit 1
  fi
done
exit 0
